{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.phiaimadeos.invalid/schemas/audit_report.schema.json",
  "title": "PhiAiMadeOs Non-AI Audit Report",
  "type": "object",
  "required": ["audit_id", "candidate_id", "candidate_version", "engine", "status", "issues", "metrics", "created_at"],
  "properties": {
    "audit_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_version": {"type": "integer", "minimum": 1},
    "engine": {"const": "deterministic_non_ai_v1"},
    "status": {"enum": ["AUDIT_BLOCKED", "AUDIT_WARNED", "READY_FOR_REVIEW"]},
    "created_at": {"type": "string", "format": "date-time"},
    "features_cache_ref": {"type": ["string", "null"]},
    "metrics": {"type": "object", "additionalProperties": true},
    "issues": {
      "type": "array",
      "items": {
        "type": "object", "required": ["code", "severity", "message", "evidence"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "severity": {"enum": ["BLOCK", "WARN", "INFO"]},
          "start_ms": {"type": ["number", "null"]},
          "end_ms": {"type": ["number", "null"]},
          "note_ids": {"type": "array", "items": {"type": "string"}},
          "line_ids": {"type": "array", "items": {"type": "string"}},
          "message": {"type": "string", "minLength": 1},
          "evidence": {"type": "object", "additionalProperties": true},
          "suggested_action": {"enum": ["fix_data", "review_only", "manual_fix", "regenerate_segment", "none"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
